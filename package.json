{
  "name": "ninopulse-global-mobile",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint . --quiet",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p ./jsconfig.json",
    "preview": "node server/index.js",
    "start": "node server/index.js",
    "test": "node --test server/*.test.js src/lib/*.test.js",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "android:sync": "node ./node_modules/@capacitor/cli/bin/capacitor sync android",
    "android:open": "node ./node_modules/@capacitor/cli/bin/capacitor open android",
    "android:run": "node ./node_modules/@capacitor/cli/bin/capacitor run android",
    "android:apk": "node scripts/android-build.js apk",
    "android:aab": "node scripts/android-build.js aab",
    "android:config": "node scripts/prepare-android-config.js",
    "android:prepare:windows": "scripts\\android-prepare.cmd",
    "android:prepare": "npm run android:config && npm run build && npm run android:sync"
  },
  "dependencies": {
    "@capacitor/android": "8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/geolocation": "8.2.4",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/local-notifications": "8.3.1",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@tanstack/react-query": "^5.84.1",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.38.0",
    "fast-xml-parser": "^5.8.0",
    "framer-motion": "^11.16.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.475.0",
    "next-themes": "^0.4.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "7.18.5",
    "recharts": "^2.15.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.0",
    "@eslint/js": "^9.19.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^22.13.5",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "baseline-browser-mapping": "^2.8.32",
    "eslint": "^9.19.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^15.14.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2",
    "vite": "^6.4.5",
    "vite-plugin-pwa": "^1.3.0"
  },
  "description": "NiñoPulse Global · local weather and official climate monitoring",
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "dompurify": "3.4.17"
  }
}
